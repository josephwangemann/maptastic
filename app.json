{
  "expo": {
    "name": "maptastic",
    "slug": "maptastic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appIcon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.josephwangemann.maptastic",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Maptastic to use your location to center the map on you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/appIcon.png",
        "backgroundImage": "./assets/appIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.josephwangemann.maptastic"
    },
    "web": {
      "favicon": "./assets/appIcon.png"
    },
    "scheme": "maptastic",
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Maptastic to use your location to center the map on you."
        }
      ],
      "expo-image",
      "expo-font"
    ]
  }
}
